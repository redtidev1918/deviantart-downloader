# DeviantArt Downloader - 环境变量示例
# 复制此文件为 .env 并填入你的配置

# ============================================
# 认证配置 Authentication
# ============================================

# DeviantArt Cookies（从浏览器获取）
# DEVIANTART_COOKIES=auth=xxx; auth_secure=xxx; userinfo=xxx

# ============================================
# 下载配置 Download Settings
# ============================================

# 默认下载质量 (o=原图, f=全图, p=预览)
# DA_QUALITY=f

# 默认下载目录
# DA_DEST=./downloads

# 默认延迟时间（秒）- 防封IP
# DA_DELAY=2

# 每批下载数量
# DA_LIMIT=24

# ============================================
# 代理配置 Proxy Settings
# ============================================

# HTTP代理
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# SOCKS代理
# ALL_PROXY=socks5://127.0.0.1:1080

# ============================================
# 语言配置 Language
# ============================================

# 界面语言 (zh_CN=中文, en_US=English)
DEVART_LANG=zh_CN

# ============================================
# 高级配置 Advanced
# ============================================

# 最大重试次数
# DA_MAX_RETRIES=3

# 并发下载数
# DA_CONCURRENT=2

# 是否显示调试信息
# DA_DEBUG=false

# ============================================
# 安全提示 Security Notes
# ============================================
# ⚠️ 重要：
# 1. 不要将包含真实数据的 .env 文件上传到 Git
# 2. 不要分享你的 Cookie 信息
# 3. 定期更新你的 Cookie（过期后需重新登录）
# 4. 使用代理时注意代理服务器的安全性
